# MOSK Compute/Storage BareMetalHosts
# Generated by MCC/MOSK Virtual Deployment
{% for node in mosk_compute_nodes %}
---
apiVersion: kaas.mirantis.com/v1alpha1
kind: BareMetalHostCredential
metadata:
  name: bm-mosk-cmp-{{ '%02d' | format(node.index) }}-credentials
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
spec:
  username: {{ bmc_username }}
  password:
    value: {{ bmc_password }}
---
apiVersion: metal3.io/v1alpha1
kind: BareMetalHost
metadata:
  name: bm-mosk-cmp-{{ '%02d' | format(node.index) }}
  namespace: {{ mosk_namespace }}
  annotations:
    "kaas.mirantis.com/baremetalhost-credentials-name": "bm-mosk-cmp-{{ '%02d' | format(node.index) }}-credentials"
    "inspect.metal3.io/hardwaredetails-storage-sort-term": "wwn ASC, by_path ASC, type ASC"
  labels:
    kaas.mirantis.com/baremetalhost-id: hw-mosk-cmp-{{ '%02d' | format(node.index) }}
    hostlabel.bm.kaas.mirantis.com/worker: 'true'
    hostlabel.bm.kaas.mirantis.com/storage: 'true'
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
spec:
  online: true
  bootMode: UEFI
  bootMACAddress: {{ node.mac_address }}
  bmc:
    address: {{ kvm_node_ip }}:{{ node.vbmc_port }}
    credentialsName: ''
    disableCertificateVerification: true
{% endfor %}

# MOSK MetalLB Configuration
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: kaas.mirantis.com/v1alpha1
kind: MetalLBConfig
metadata:
  name: {{ mosk_namespace }}-metallb
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    cluster.sigs.k8s.io/cluster-name: {{ mosk_namespace }}
spec:
  ipAddressPools:
    - name: openstack-external
      spec:
        addresses:
          - {{ mosk_metallb_range_start }}-{{ mosk_metallb_range_end }}
        autoAssign: true
        avoidBuggyIPs: false
    - name: openstack-internal
      spec:
        addresses:
          - {{ mosk_metallb_internal_start }}-{{ mosk_metallb_internal_end }}
        autoAssign: false
        avoidBuggyIPs: false
  l2Advertisements:
    - name: openstack-external
      spec:
        interfaces:
          - k8s-lcm
        ipAddressPools:
          - openstack-external
    - name: openstack-internal
      spec:
        interfaces:
          - k8s-lcm
        ipAddressPools:
          - openstack-internal

# MOSK MetalLB Configuration
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: kaas.mirantis.com/v1alpha1
kind: MetalLBConfig
metadata:
  name: {{ mosk_namespace }}-metallb-config
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
    cluster.sigs.k8s.io/cluster-name: {{ mosk_namespace }}
spec:
  ipAddressPools:
    - name: services
      spec:
        addresses:
          - {{ mosk_metallb_pool }}
        autoAssign: true
        avoidBuggyIPs: false
  l2Advertisements:
    - name: services
      spec:
        ipAddressPools:
          - services
        interfaces:
          - k8s-lcm

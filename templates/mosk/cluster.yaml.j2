# MOSK Cluster Configuration
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: cluster.k8s.io/v1alpha1
kind: Cluster
metadata:
  name: {{ mosk_namespace }}
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
spec:
  clusterNetwork:
    services:
      cidrBlocks:
        - {{ mosk_service_cidr }}
    pods:
      cidrBlocks:
        - {{ mosk_pod_cidr }}
  providerSpec:
    value:
      apiVersion: baremetal.k8s.io/v1alpha1
      kind: BaremetalClusterProviderSpec
      release: {{ mosk_release }}
      dedicatedControlPlane: {{ dedicated_control_plane | lower }}
      dedicatedMetallbPools: true
      nodeCidr: {{ mosk_lcm_cidr | default('192.168.123.0/24') }}
      dnsNameservers:
{% for dns in dns_servers %}
        - {{ dns }}
{% endfor %}
      helmReleases:
        - name: metallb
          values:
            speaker:
              nodeSelector:
                openstack-control-plane: enabled
        - name: ceph-controller
          values: {}
        - name: stacklight
          values:
            clusterSize: {{ stacklight_cluster_size | default('small') }}
            highAvailabilityEnabled: true
            ceph:
              enabled: true
            openstack:
              insecure:
                external: true
            elasticsearch:
              persistentVolumeClaimSize: {{ stacklight_elasticsearch_size | default('30Gi') }}
              retentionTime:
                logstash: {{ stacklight_retention_days | default(2) }}d
                events: {{ stacklight_retention_days | default(2) }}d
                notifications: {{ stacklight_retention_days | default(2) }}d
            logging:
              enabled: true
              level: WARNING
              persistentVolumeClaimSize: {{ stacklight_logging_size | default('10Gi') }}
            prometheusServer:
              persistentVolumeClaimSize: {{ stacklight_prometheus_size | default('10Gi') }}
              retentionSize: {{ stacklight_prometheus_retention_size | default('9GB') }}
              retentionTime: {{ stacklight_retention_days | default(2) }}d
              watchDogAlertEnabled: false
      publicKeys:
        - name: bootstrap-key
      audit:
        auditd:
          enabled: false
      kaas:
        management:
          enabled: false

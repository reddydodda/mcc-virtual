# MOSK Compute Machines
# Generated by MCC/MOSK Virtual Deployment
{% for node in mosk_compute_nodes %}
---
apiVersion: cluster.k8s.io/v1alpha1
kind: Machine
metadata:
  name: mosk-cmp-{{ '%02d' | format(node.index) }}
  namespace: {{ mosk_namespace }}
  labels:
    cluster.sigs.k8s.io/cluster-name: {{ mosk_namespace }}
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
spec:
  providerSpec:
    value:
      apiVersion: baremetal.k8s.io/v1alpha1
      kind: BareMetalMachineProviderSpec
      distribution: ubuntu/jammy
      day1Deployment: "auto"
      bareMetalHostProfile:
        name: mosk-cmp
        namespace: {{ mosk_namespace }}
      l2TemplateSelector:
        name: mosk-default
        namespace: {{ mosk_namespace }}
      nodeLabels:
        - key: openvswitch
          value: enabled
        - key: openstack-compute-node
          value: enabled
        - key: node-type
{% if is_hyperconverged %}
          value: cmp-hc
{% else %}
          value: cmp
{% endif %}
      hostSelector:
        matchLabels:
          kaas.mirantis.com/baremetalhost-id: hw-mosk-cmp-{{ '%02d' | format(node.index) }}
          hostlabel.bm.kaas.mirantis.com/worker: 'true'
{% if is_hyperconverged %}
          hostlabel.bm.kaas.mirantis.com/storage: 'true'
{% endif %}
{% endfor %}

# MOSK KaaSCephCluster
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: kaas.mirantis.com/v1alpha1
kind: KaaSCephCluster
metadata:
  name: {{ mosk_namespace }}
  namespace: {{ mosk_namespace }}
spec:
  cephClusterSpec:
    ingress:
      publicDomain: {{ ceph_public_domain }}
      tlsCert: |
{{ tls_server_cert | indent(8, first=True) }}
      cacert: |
{{ tls_ca_cert | indent(8, first=True) }}
      tlsKey: |
{{ tls_server_key | indent(8, first=True) }}
    network:
      clusterNet: {{ ceph_cluster_network }}
      publicNet: {{ ceph_public_network }}
    nodes:
{% for node in mosk_control_nodes %}
      mosk-ctl-{{ '%02d' | format(node.index) }}:
        roles:
          - mgr
          - mon
{% endfor %}
{% if is_hyperconverged %}
      # Hyperconverged mode: OSDs on compute nodes
{% for node in mosk_compute_nodes %}
      mosk-cmp-{{ '%02d' | format(node.index) }}:
        storageDevices:
{% for device in ceph_osd_devices %}
          - name: {{ device }}
            config:
              deviceClass: hdd
              osdsPerDevice: "1"
{% endfor %}
{% endfor %}
{% else %}
      # Dedicated storage mode: OSDs on storage nodes
{% for node in mosk_storage_nodes %}
      mosk-storage-{{ '%02d' | format(node.index) }}:
        storageDevices:
{% for device in ceph_osd_devices %}
          - name: {{ device }}
            config:
              deviceClass: hdd
              osdsPerDevice: "1"
{% endfor %}
{% endfor %}
{% endif %}
    objectStorage:
      rgw:
        name: rgw-store
        preservePoolsOnDelete: false
        gateway:
          allNodes: false
          instances: {{ ceph_rgw_instances | default(3) }}
          port: 80
          securePort: 8443
        dataPool:
          deviceClass: hdd
          failureDomain: host
          replicated:
            size: {{ ceph_pool_replication_size | default(2) }}
        metadataPool:
          deviceClass: hdd
          failureDomain: host
          replicated:
            size: {{ ceph_pool_replication_size | default(2) }}
    pools:
{% for pool in ceph_pools %}
      - name: {{ pool.name }}
        role: {{ pool.role }}
        default: {{ pool.default | default(false) | lower }}
        deviceClass: hdd
        failureDomain: host
        replicated:
          size: {{ pool.size | default(2) }}
{% endfor %}
  k8sCluster:
    name: {{ mosk_namespace }}
    namespace: {{ mosk_namespace }}

# MOSK L2Template
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: ipam.mirantis.com/v1alpha1
kind: L2Template
metadata:
  name: mosk-default
  namespace: {{ mosk_namespace }}
spec:
  autoIfMappingPrio:
    - type: l2templatemapping
    - type: byhwaddr
    - type: byname
    - type: byipam
  npTemplate: |-
{% raw %}
    version: 2
    ethernets:
      {{nic 0}}:
        match:
          macaddress: {{mac 0}}
        set-name: {{nic 0}}
        addresses:
{% endraw %}
{% for ip in mosk_management_ips %}
          - {{ ip }}/{{ mosk_management_prefix }}
{% endfor %}
{% raw %}
        gateway4: {{gateway "k8s-lcm"}}
        nameservers:
{% endraw %}
          addresses:
{% for dns in dns_servers %}
            - {{ dns }}
{% endfor %}
{% raw %}
    bridges:
      br-ex:
        addresses: []
        interfaces:
          - {{nic 1}}
        mtu: {{ external_mtu | default(1500) }}
        parameters:
          forward-delay: 0
          stp: false
      br-prov:
        addresses: []
        interfaces:
          - {{nic 2}}
        mtu: {{ provider_mtu | default(1500) }}
        parameters:
          forward-delay: 0
          stp: false
{% endraw %}
  l3Layout:
    - subnetName: mosk-lcm-subnet
      scope: namespace
    - subnetName: mosk-pxe-subnet
      scope: namespace

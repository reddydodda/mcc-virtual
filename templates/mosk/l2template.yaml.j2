# MOSK L2Templates
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: ipam.mirantis.com/v1alpha1
kind: L2Template
metadata:
  name: mosk-ctl
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
    cluster.sigs.k8s.io/cluster-name: {{ mosk_namespace }}
    ipam/DefaultForCluster: "1"
spec:
  autoIfMappingPrio:
  - provision
  - eno
  - ens
  - enp
  l3Layout:
    - scope: namespace
      subnetName: mosk-lcm-subnet
      labelSelector:
        kaas.mirantis.com/provider: baremetal
        ipam/SVC-k8s-lcm: "true"
    - scope: namespace
      subnetName: mosk-pxe-subnet
  npTemplate: |
    version: 2
    renderer: networkd
    ethernets:
      {{ nic 0 }}:
        dhcp4: false
        dhcp6: false
        match:
          macaddress: {{ mac 0 }}
        set-name: {{ nic 0 }}
      {{ nic 1 }}:
        dhcp4: false
        dhcp6: false
        match:
          macaddress: {{ mac 1 }}
        set-name: {{ nic 1 }}
      {{ nic 2 }}:
        dhcp4: false
        dhcp6: false
        match:
          macaddress: {{ mac 2 }}
        set-name: {{ nic 2 }}
      {{ nic 3 }}:
        dhcp4: false
        dhcp6: false
        match:
          macaddress: {{ mac 3 }}
        set-name: {{ nic 3 }}
    bridges:
      k8s-lcm:
        interfaces:
          - {{ nic 1 }}
        addresses:
          - {{ ip "k8s-lcm:mosk-lcm-subnet" }}
        routes:
          - to: 0.0.0.0/0
            via: {{ gateway_from_subnet "mosk-lcm-subnet" }}
        nameservers:
          addresses: {{ nameservers_from_subnet "mosk-lcm-subnet" }}
      k8s-pxe:
        interfaces:
          - {{ nic 0 }}
        addresses:
          - {{ ip "k8s-pxe:mosk-pxe-subnet" }}
      br-fip:
        interfaces:
          - {{ nic 2 }}

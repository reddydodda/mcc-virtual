# MOSK Compute BareMetalHostProfile
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: metal3.io/v1alpha1
kind: BareMetalHostProfile
metadata:
  name: mosk-cmp
  namespace: {{ mosk_namespace }}
spec:
  devices:
    - device:
        minSize: 60Gi
        workBy: by_id,by_wwn,by_path,by_name
        wipeDevice:
          eraseMetadata:
            enabled: true
      partitions:
        - name: bios_grub
          size: 4Mi
          partflags:
            - bios_grub
        - name: uefi
          size: 200Mi
          partflags:
            - esp
        - name: config-2
          size: 64Mi
        - name: lvm_root_part
          size: 0
{% if is_hyperconverged %}
    - device:
        minSize: 30Gi
        workBy: by_id,by_wwn,by_path,by_name
        wipeDevice:
          eraseMetadata:
            enabled: true
      partitions:
        - name: lvm_lvp_part
          size: 0
{% endif %}
  fileSystems:
    - fileSystem: vfat
      partition: config-2
    - fileSystem: vfat
      partition: uefi
      mountPoint: /boot/efi
    - fileSystem: ext4
      logicalVolume: root
      mountPoint: /
{% if is_hyperconverged %}
    - fileSystem: ext4
      logicalVolume: lvp
      mountPoint: /mnt/local-volumes/
{% endif %}
  logicalVolumes:
    - name: root
      size: 0
      vg: lvm_root
{% if is_hyperconverged %}
    - name: lvp
      size: 0
      vg: lvm_lvp
{% endif %}
  volumeGroups:
    - name: lvm_root
      devices:
        - partition: lvm_root_part
{% if is_hyperconverged %}
    - name: lvm_lvp
      devices:
        - partition: lvm_lvp_part
{% endif %}
  grubConfig:
    defaultGrubOptions:
      - GRUB_DISABLE_RECOVERY="true"
      - GRUB_PRELOAD_MODULES=lvm
      - GRUB_TIMEOUT=20
      - GRUB_CMDLINE_LINUX="console=tty0 console=ttyS0,115200n8"
  preDeployScript: |
    #!/bin/bash -ex
    echo $(date) 'pre_deploy_script done' >> /root/pre_deploy_done
  postDeployScript: |
    #!/bin/bash -ex
    echo $(date) 'post_deploy_script done' >> /root/post_deploy_done

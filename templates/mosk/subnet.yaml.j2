# MOSK Subnets
# Generated by MCC/MOSK Virtual Deployment
---
# LCM Network Subnet - for k8s-lcm bridge
# Used for node management, live migration, internal services
apiVersion: ipam.mirantis.com/v1alpha1
kind: Subnet
metadata:
  name: k8s-lcm-nics
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
    cluster.sigs.k8s.io/cluster-name: {{ mosk_namespace }}
    ipam/SVC-k8s-lcm: "presents"
spec:
  cidr: {{ mosk_lcm_cidr }}
  gateway: {{ mosk_lcm_gateway }}
  includeRanges:
    - {{ mosk_lcm_range_start }}-{{ mosk_lcm_range_end }}
  nameservers:
{% for dns in dns_servers %}
    - {{ dns }}
{% endfor %}
---
# Others/Tenant Network Subnet - for k8s-others bridge
# Used for neutron tunnels, Ceph public/cluster traffic
apiVersion: ipam.mirantis.com/v1alpha1
kind: Subnet
metadata:
  name: k8s-others
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
    cluster.sigs.k8s.io/cluster-name: {{ mosk_namespace }}
    ipam/SVC-k8s-others: "presents"
spec:
  cidr: {{ mosk_tenant_cidr | default('192.168.124.0/24') }}
  gateway: {{ mosk_tenant_gateway | default('192.168.124.1') }}
  includeRanges:
    - {{ mosk_tenant_range_start | default('192.168.124.10') }}-{{ mosk_tenant_range_end | default('192.168.124.100') }}
  nameservers:
{% for dns in dns_servers %}
    - {{ dns }}
{% endfor %}
---
# Kubernetes API LoadBalancer Subnet
# Single IP for the MOSK cluster API endpoint
apiVersion: ipam.mirantis.com/v1alpha1
kind: Subnet
metadata:
  name: mosk-k8s-api-lb
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
    cluster.sigs.k8s.io/cluster-name: {{ mosk_namespace }}
    ipam/SVC-LBhost: "presents"
spec:
  cidr: {{ mosk_api_lb_cidr | default('192.168.123.100/32') }}
  useWholeCidr: true

# MOSK Subnets
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: ipam.mirantis.com/v1alpha1
kind: Subnet
metadata:
  name: mosk-lcm-subnet
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    ipam/SVC-k8s-lcm: "true"
spec:
  cidr: {{ mosk_lcm_cidr }}
  gateway: {{ mosk_lcm_gateway }}
  includeRanges:
    - {{ mosk_lcm_range_start }}-{{ mosk_lcm_range_end }}
  nameservers:
{% for dns in dns_servers %}
    - {{ dns }}
{% endfor %}
---
apiVersion: ipam.mirantis.com/v1alpha1
kind: Subnet
metadata:
  name: mosk-pxe-subnet
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    ipam/SVC-pxe: "true"
spec:
  cidr: {{ mosk_pxe_cidr }}
  includeRanges:
    - {{ mosk_pxe_range_start }}-{{ mosk_pxe_range_end }}
---
apiVersion: ipam.mirantis.com/v1alpha1
kind: Subnet
metadata:
  name: mosk-storage-subnet
  namespace: {{ mosk_namespace }}
  labels:
    kaas.mirantis.com/provider: baremetal
    ipam/SVC-ceph-public: "true"
    ipam/SVC-ceph-cluster: "true"
spec:
  cidr: {{ mosk_storage_cidr }}
  includeRanges:
    - {{ mosk_storage_range_start }}-{{ mosk_storage_range_end }}

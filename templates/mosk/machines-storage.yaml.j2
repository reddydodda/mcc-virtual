# MOSK Storage Machines
# Generated by MCC/MOSK Virtual Deployment
# Only rendered in dedicated storage mode
{% if not is_hyperconverged and mosk_storage_nodes %}
{% for node in mosk_storage_nodes %}
---
apiVersion: cluster.k8s.io/v1alpha1
kind: Machine
metadata:
  name: mosk-storage-{{ '%02d' | format(node.index) }}
  namespace: {{ mosk_namespace }}
  labels:
    cluster.sigs.k8s.io/cluster-name: {{ mosk_namespace }}
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
spec:
  providerSpec:
    value:
      apiVersion: baremetal.k8s.io/v1alpha1
      kind: BareMetalMachineProviderSpec
      distribution: ubuntu/jammy
      day1Provisioning: "auto"
      day1Deployment: "auto"
      bareMetalHostProfile:
        name: mosk-storage
        namespace: {{ mosk_namespace }}
      l2TemplateSelector:
        name: mosk-default
        namespace: {{ mosk_namespace }}
      nodeLabels:
        - key: node-type
          value: storage
      hostSelector:
        matchLabels:
          kaas.mirantis.com/baremetalhost-id: hw-mosk-storage-{{ '%02d' | format(node.index) }}
{% endfor %}
{% endif %}

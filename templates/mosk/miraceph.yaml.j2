# MOSK MiraCeph Configuration
# Generated by MCC/MOSK Virtual Deployment
# Replaces deprecated KaaSCephCluster starting from MOSK 25.2
---
apiVersion: lcm.mirantis.com/v1alpha1
kind: MiraCeph
metadata:
  name: {{ mosk_namespace }}
  namespace: ceph-lcm-mirantis
spec:
  network:
    publicNet: {{ ceph_public_network }}
    clusterNet: {{ ceph_cluster_network }}

  nodes:
    # Monitor and Manager nodes (control plane)
{% for node in mosk_control_nodes %}
    - name: mosk-ctl-{{ '%02d' | format(node.index) }}
      roles:
        - mon
        - mgr
{% endfor %}

{% if is_hyperconverged %}
    # Hyperconverged mode: OSDs on compute nodes
{% for node in mosk_compute_nodes %}
    - name: mosk-cmp-{{ '%02d' | format(node.index) }}
      devices:
{% for device in ceph_osd_devices %}
        - fullPath: /dev/{{ device }}
          config:
            deviceClass: hdd
{% endfor %}
{% endfor %}
{% else %}
    # Dedicated storage mode: OSDs on storage nodes
{% for node in mosk_storage_nodes %}
    - name: mosk-storage-{{ '%02d' | format(node.index) }}
      devices:
{% for device in ceph_osd_devices %}
        - fullPath: /dev/{{ device }}
          config:
            deviceClass: hdd
{% endfor %}
{% endfor %}
{% endif %}

  pools:
{% for pool in ceph_pools %}
    - name: {{ pool.name }}
      role: {{ pool.role }}
      default: {{ pool.default | default(false) | lower }}
      deviceClass: hdd
      replicated:
        size: {{ pool.size | default(2) }}
{% endfor %}

  objectStorage:
    rgw:
      name: {{ ceph_rgw_store_name | default('rgw-store') }}
      instances: {{ ceph_rgw_instances | default(3) }}
      port: 80
      securePort: 8443
      preservePoolsOnDelete: false
      SSLCert:
        cacert: |
{{ tls_ca_cert | indent(10, first=True) }}
        tlsCert: |
{{ tls_server_cert | indent(10, first=True) }}
        tlsKey: |
{{ tls_server_key | indent(10, first=True) }}
      metadataPool:
        deviceClass: hdd
        failureDomain: host
        replicated:
          size: {{ ceph_pool_replication_size | default(2) }}
      dataPool:
        deviceClass: hdd
        failureDomain: host
        replicated:
          size: {{ ceph_pool_replication_size | default(2) }}

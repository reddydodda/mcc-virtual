# MOSK Storage BareMetalHostProfile
# Generated by MCC/MOSK Virtual Deployment
# Only rendered in dedicated storage mode
{% if not is_hyperconverged %}
---
apiVersion: metal3.io/v1alpha1
kind: BareMetalHostProfile
metadata:
  name: mosk-storage
  namespace: {{ mosk_namespace }}
spec:
  devices:
    - device:
        minSize: 60Gi
        workBy: by_id,by_wwn,by_path,by_name
        wipeDevice:
          eraseMetadata:
            enabled: true
      partitions:
        - name: bios_grub
          size: 4Mi
          partflags:
            - bios_grub
        - name: uefi
          size: 200Mi
          partflags:
            - esp
        - name: config-2
          size: 64Mi
        - name: lvm_root_part
          size: 0
{% for device in ceph_osd_devices %}
    - device:
        minSize: 30Gi
        workBy: by_id,by_wwn,by_path,by_name
        wipeDevice:
          eraseMetadata:
            enabled: true
      partitions: []
{% endfor %}
  fileSystems:
    - fileSystem: vfat
      partition: config-2
    - fileSystem: vfat
      partition: uefi
      mountPoint: /boot/efi
    - fileSystem: ext4
      logicalVolume: root
      mountPoint: /
  logicalVolumes:
    - name: root
      size: 0
      vg: lvm_root
  volumeGroups:
    - name: lvm_root
      devices:
        - partition: lvm_root_part
  grubConfig:
    defaultGrubOptions:
      - GRUB_DISABLE_RECOVERY="true"
      - GRUB_PRELOAD_MODULES=lvm
      - GRUB_TIMEOUT=20
      - GRUB_CMDLINE_LINUX="console=tty0 console=ttyS0,115200n8"
  preDeployScript: |
    #!/bin/bash -ex
    echo $(date) 'pre_deploy_script done' >> /root/pre_deploy_done
  postDeployScript: |
    #!/bin/bash -ex
    echo $(date) 'post_deploy_script done' >> /root/post_deploy_done
    # Prepare OSD disks
{% for device in ceph_osd_devices %}
    wipefs -a /dev/{{ device }} || true
{% endfor %}
{% endif %}

# MOSK Storage BareMetalHostProfile
# Generated by MCC/MOSK Virtual Deployment
# Only rendered in dedicated storage mode
{% if not is_hyperconverged %}
---
apiVersion: metal3.io/v1alpha1
kind: BareMetalHostProfile
metadata:
  name: mosk-storage
  namespace: {{ mosk_namespace }}
spec:
  devices:
    - device:
        byName: /dev/vda
      partitions:
        - name: bios_grub
          size: 4 MiB
          partflags:
            - bios_grub
        - name: uefi
          size: 200 MiB
          partflags:
            - esp
        - name: boot
          size: 1 GiB
        - name: root
          size: 0
      grubConfig:
        cmdlineOpts: console=tty0 console=ttyS0,115200n8
{% for device in ceph_osd_devices %}
    - device:
        byName: /dev/{{ device }}
      partitions: []
{% endfor %}
  fileSystems:
    - fileSystem: vfat
      partition: uefi
      mountPoint: /boot/efi
    - fileSystem: ext4
      partition: boot
      mountPoint: /boot
    - fileSystem: ext4
      partition: root
      mountPoint: /
  grubConfig:
    cmdlineOpts: console=tty0 console=ttyS0,115200n8
  preDeployScript: |
    #!/bin/bash
    set -ex
    echo "Pre-deploy script for MOSK storage node"
  postDeployScript: |
    #!/bin/bash
    set -ex
    echo "Post-deploy script for MOSK storage node"
    # Prepare OSD disks
{% for device in ceph_osd_devices %}
    wipefs -a /dev/{{ device }} || true
{% endfor %}
{% endif %}

# OpenStack Deployment
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: lcm.mirantis.com/v1alpha1
kind: OpenStackDeployment
metadata:
  name: osh-dev
  namespace: openstack
spec:
  openstack_version: {{ openstack_version }}
  preset: {{ openstack_preset }}
  size: {{ openstack_size }}
  internal_domain_name: cluster.local
  public_domain_name: {{ osdpl_public_domain }}
  features:
    ssl:
      public_endpoints:
        ca_cert:
          value_from:
            secret_key_ref:
              name: openstack-ssl-secret
              key: ca_cert
        api_cert:
          value_from:
            secret_key_ref:
              name: openstack-ssl-secret
              key: api_cert
        api_key:
          value_from:
            secret_key_ref:
              name: openstack-ssl-secret
              key: api_key
    neutron:
      backend: ml2/ovn
      tunnel_interface: k8s-others
      dvr:
        enabled: {{ openstack_dvr_enabled | default(true) | capitalize }}
      external_networks:
        - physnet: physnet1
          interface: k8s-fip
          bridge: br-ex
          network_types:
           - flat
          vlan_ranges: null
          mtu: null
      floating_network:
        enabled: True
        physnet: physnet1
        subnet:
          range: {{ mosk_fip_cidr }}
          pool_start: {{ mosk_fip_pool_start | default('192.168.125.100') }}
          pool_end: {{ mosk_fip_pool_end | default('192.168.125.200') }}
          gateway: {{ mosk_fip_gateway }}
    nova:
      images:
        backend: ceph
      live_migration_interface: k8s-others
    database:
      backup:
        enabled: {{ openstack_db_backup_enabled | default(true) | lower }}

# OpenStack Deployment
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: lcm.mirantis.com/v1alpha1
kind: OpenStackDeployment
metadata:
  name: osh-dev
  namespace: openstack
spec:
  openstack_version: {{ openstack_version }}
  preset: {{ openstack_preset }}
  size: {{ openstack_size }}
  internal_domain_name: cluster.local
  public_domain_name: {{ osdpl_public_domain }}
  features:
    services:
{% for service in openstack_services | default(['barbican', 'cinder', 'glance', 'heat', 'horizon', 'keystone', 'neutron', 'nova', 'octavia', 'placement', 'tempest']) %}
      - {{ service }}
{% endfor %}
    neutron:
      dvr: {{ openstack_dvr_enabled | default(true) | lower }}
      backend: ml2/ovn
{% if openstack_baremetal_enabled | default(false) %}
    ironic:
      enabled: true
{% endif %}
    nova:
      images:
        backend: ceph
      live_migration_interface: {{ nova_live_migration_interface | default('k8s-lcm') }}
    ssl:
      public_endpoints:
        api_cert: openstack-ssl-certificate
      internal_endpoints:
        api_cert: openstack-ssl-certificate
    database:
      backup:
        enabled: {{ openstack_db_backup_enabled | default(true) | lower }}
  services:
    networking:
      neutron:
        values:
          conf:
            neutron:
              DEFAULT:
                dns_domain: {{ neutron_dns_domain | default('openstacklocal') }}
                global_physnet_mtu: {{ neutron_global_mtu | default(1500) }}
{% for dns in dns_servers %}
              dns_nameservers: {{ dns }}
{% endfor %}
            plugins:
              ml2_conf:
                ml2_type_flat:
                  flat_networks: {{ neutron_flat_networks | default('physnet1') }}
                ml2_type_vlan:
                  network_vlan_ranges: {{ neutron_vlan_ranges | default('physnet1:100:200') }}
          network:
            interface:
              tunnel: {{ neutron_tunnel_interface | default('k8s-others') }}
          labels:
            ovs:
              node_selector_key: openvswitch
              node_selector_value: enabled
    orchestration:
      heat:
        values:
          conf:
            heat:
              DEFAULT:
                num_engine_workers: 2
    compute:
      nova:
        values:
          conf:
            nova:
              DEFAULT:
                cpu_allocation_ratio: {{ nova_cpu_allocation_ratio | default(4.0) }}
                ram_allocation_ratio: {{ nova_ram_allocation_ratio | default(1.0) }}
                disk_allocation_ratio: {{ nova_disk_allocation_ratio | default(1.0) }}
              libvirt:
                cpu_mode: host-passthrough
          network:
            backend:
              - openvswitch
          labels:
            agent:
              compute:
                node_selector_key: openstack-compute-node
                node_selector_value: enabled
    load-balancer:
      octavia:
        values:
          conf:
            octavia:
              controller_worker:
                amp_flavor_id: {{ octavia_amp_flavor_id | default('65') }}
              networking:
                lb_network_name: {{ octavia_lb_network_name | default('lb-mgmt-net') }}
          network:
            lb_network:
              cidr: {{ octavia_lb_cidr }}
    image:
      glance:
        values:
          storage: ceph
  nodes:
{% for node in mosk_control_nodes %}
    mosk-ctl-{{ '%02d' | format(node.index) }}:
      features:
        - services
{% endfor %}
{% for node in mosk_compute_nodes %}
    mosk-cmp-{{ '%02d' | format(node.index) }}:
      features:
        - services
{% endfor %}

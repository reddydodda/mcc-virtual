# MOSK Control Plane Machines
# Generated by MCC/MOSK Virtual Deployment
{% for node in mosk_control_nodes %}
---
apiVersion: cluster.k8s.io/v1alpha1
kind: Machine
metadata:
  name: mosk-ctl-{{ '%02d' | format(node.index) }}
  namespace: {{ mosk_namespace }}
  labels:
    cluster.sigs.k8s.io/cluster-name: {{ mosk_namespace }}
    kaas.mirantis.com/provider: baremetal
    kaas.mirantis.com/region: region-one
spec:
  providerSpec:
    value:
      apiVersion: baremetal.k8s.io/v1alpha1
      kind: BareMetalMachineProviderSpec
      distribution: ubuntu/jammy
      day1Provisioning: "auto"
      day1Deployment: "auto"
      bareMetalHostProfile:
        name: mosk-ctl
        namespace: {{ mosk_namespace }}
      l2TemplateSelector:
        name: mosk-default
        namespace: {{ mosk_namespace }}
      nodeLabels:
        - key: openstack-control-plane
          value: enabled
        - key: openstack-gateway
          value: enabled
        - key: openvswitch
          value: enabled
        - key: stacklight
          value: enabled
      hostSelector:
        matchLabels:
          kaas.mirantis.com/baremetalhost-id: hw-mosk-ctl-{{ '%02d' | format(node.index) }}
{% endfor %}

# MCC BareMetalHost Credentials and Resources
# Generated by MCC/MOSK Virtual Deployment
{% for node in mcc_nodes %}
---
apiVersion: kaas.mirantis.com/v1alpha1
kind: BareMetalHostCredential
metadata:
  name: master-{{ node.index }}-bmc-credentials
  namespace: default
  labels:
    kaas.mirantis.com/provider: baremetal
spec:
  username: {{ bmc_username }}
  password:
    value: {{ bmc_password }}
---
apiVersion: metal3.io/v1alpha1
kind: BareMetalHost
metadata:
  name: master-{{ node.index }}
  labels:
    kaas.mirantis.com/provider: baremetal
    baremetal: hw-master-{{ node.index }}
  annotations:
    "kaas.mirantis.com/baremetalhost-credentials-name": "master-{{ node.index }}-bmc-credentials"
spec:
  bootMode: UEFI
  online: true
  bootMACAddress: {{ node.mac_address }}
  bmc:
    address: {{ kvm_node_ip }}:{{ node.vbmc_port }}
    credentialsName: ''
{% endfor %}

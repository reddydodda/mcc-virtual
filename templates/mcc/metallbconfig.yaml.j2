# MCC MetalLB Configuration
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: kaas.mirantis.com/v1alpha1
kind: MetalLBConfigTemplate
metadata:
  name: default
  labels:
    kaas.mirantis.com/provider: baremetal
spec:
  autoAssign: true
  l2AdvertisementSpec:
    nodeSelectors:
      - matchLabels: {}
    interfaces:
      - k8s-lcm
  ipAddressPools:
{% for pool in mcc_metallb_pools %}
    - name: {{ pool.name }}
      addresses:
{% for addr in pool.addresses %}
        - {{ addr }}
{% endfor %}
{% if pool.interface %}
      l2AdvertisementSpec:
        interfaces:
          - {{ pool.interface }}
{% endif %}
{% endfor %}

# MCC IPAM Objects
# Generated by MCC/MOSK Virtual Deployment

# L2 Template for network configuration
---
apiVersion: ipam.mirantis.com/v1alpha1
kind: L2Template
metadata:
  name: default
  namespace: default
  labels:
    kaas.mirantis.com/provider: baremetal
spec:
  autoIfMappingPrio:
    - type: l2template-target-label
      value: nic-first-mac
  l3Layout:
{% for network in mcc_networks %}
    - scope: {{ network.scope }}
      subnetName: {{ network.subnet_name }}
{% endfor %}
  npTemplate: |
    version: 2
    renderer: networkd
    ethernets:
{% raw %}
      {{ nic "k8s-pxe" }}:
        dhcp4: false
        dhcp6: false
      {{ nic "k8s-lcm" }}:
        dhcp4: false
        dhcp6: false
    bridges:
      k8s-pxe:
        dhcp4: false
        dhcp6: false
        interfaces:
          - {{ nic "k8s-pxe" }}
        addresses:
          - {{ ip "k8s-pxe" }}
        routes:
        - to: 0.0.0.0/0
          via: {{ gateway "k8s-pxe" }}
        nameservers:
          addresses:
{% endraw %}
{% for dns in dns_servers %}
            - {{ dns }}
{% endfor %}
{% raw %}
      k8s-lcm:
        dhcp4: false
        dhcp6: false
        interfaces:
          - {{ nic "k8s-lcm" }}
        addresses:
          - {{ ip "k8s-lcm" }}
{% endraw %}

# Subnets
{% for subnet in mcc_subnets %}
---
apiVersion: ipam.mirantis.com/v1alpha1
kind: Subnet
metadata:
  name: {{ subnet.name }}
  namespace: default
  labels:
    kaas.mirantis.com/provider: baremetal
{% if subnet.cluster %}
    cluster.sigs.k8s.io/cluster-name: {{ subnet.cluster }}
{% endif %}
{% if subnet.ipam_pool_name %}
    ipam/SVC-pool-name: {{ subnet.ipam_pool_name }}
{% endif %}
spec:
  cidr: {{ subnet.cidr }}
{% if subnet.gateway %}
  gateway: {{ subnet.gateway }}
{% endif %}
{% if subnet.include_ranges %}
  includeRanges:
{% for range in subnet.include_ranges %}
    - {{ range }}
{% endfor %}
{% endif %}
{% if subnet.exclude_ranges %}
  excludeRanges:
{% for range in subnet.exclude_ranges %}
    - {{ range }}
{% endfor %}
{% endif %}
{% if subnet.use_whole_cidr %}
  useWholeCidr: true
{% endif %}
{% endfor %}

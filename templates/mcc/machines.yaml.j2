# MCC Machine Resources
# Generated by MCC/MOSK Virtual Deployment
{% for node in mcc_nodes %}
---
apiVersion: cluster.k8s.io/v1alpha1
kind: Machine
metadata:
  name: {{ mcc_cluster_name }}-master-{{ node.index }}
  labels:
    cluster.sigs.k8s.io/cluster-name: {{ mcc_cluster_name }}
    cluster.sigs.k8s.io/control-plane: "true"
    kaas.mirantis.com/provider: baremetal
spec:
  providerSpec:
    value:
      apiVersion: baremetal.k8s.io/v1alpha1
      kind: BareMetalMachineProviderSpec
      distribution: ubuntu/jammy
      day1Deployment: "auto"
      bareMetalHostProfile:
        name: default
        namespace: default
      l2TemplateSelector:
        name: default
        namespace: default
      hostSelector:
        matchLabels:
          baremetal: hw-master-{{ node.index }}
{% endfor %}

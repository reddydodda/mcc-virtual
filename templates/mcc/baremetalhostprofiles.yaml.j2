# MCC BareMetalHost Profiles
# Generated by MCC/MOSK Virtual Deployment
---
apiVersion: kaas.mirantis.com/v1alpha1
kind: BareMetalHostProfile
metadata:
  name: default
  namespace: default
  labels:
    kaas.mirantis.com/provider: baremetal
spec:
  devices:
    - device:
        byName: /dev/sda
        minSize: 60Gi
        wipe: true
      partitions:
        - name: bios_grub
          size: 4Mi
          partflags:
            - bios_grub
        - name: uefi
          size: 200Mi
          partflags:
            - esp
        - name: config-2
          size: 64Mi
        - name: lvm_root_part
          size: 0  # Use remaining space
      type: disk
    - device:
        byName: /dev/sdb
        minSize: 30Gi
        wipe: true
      partitions:
        - name: lvm_lvp_part
          size: 0  # Use remaining space
      type: disk
  volumeGroups:
    - devices:
        - partition: lvm_root_part
      name: lvm_root
    - devices:
        - partition: lvm_lvp_part
      name: lvm_lvp
  logicalVolumes:
    - name: root
      size: 0  # Use remaining space
      vg: lvm_root
    - name: lvp
      size: 0  # Use remaining space
      vg: lvm_lvp
  fileSystems:
    - fileSystem: vfat
      partition: uefi
    - fileSystem: ext4
      logicalVolume: root
      mountPoint: /
    - fileSystem: ext4
      logicalVolume: lvp
      mountPoint: /mnt/local-volumes
  grubConfig:
    cmdlineLinux:
{% for param in kernel_parameters | default(['console=tty0', 'console=ttyS0,115200n8']) %}
      - {{ param }}
{% endfor %}
  preDeployScript: |
    #!/bin/bash
    set -e
    echo "Pre-deploy script started"
  postDeployScript: |
    #!/bin/bash
    set -e
    echo "Post-deploy script started"
    # Configure system settings
{% for sysctl_key, sysctl_value in kernel_sysctl | default({}) | dictsort %}
    sysctl -w {{ sysctl_key }}={{ sysctl_value }}
{% endfor %}

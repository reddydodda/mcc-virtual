# MCC Management Cluster Configuration
# Generated by MCC/MOSK Virtual Deployment
apiVersion: cluster.k8s.io/v1alpha1
kind: Cluster
metadata:
  name: {{ mcc_cluster_name }}
  labels:
    kaas.mirantis.com/provider: baremetal
spec:
  clusterNetwork:
    services:
      cidrBlocks:
        - {{ mcc_service_cidr }}
    pods:
      cidrBlocks:
        - {{ mcc_pod_cidr }}
  providerSpec:
    value:
      apiVersion: baremetal.k8s.io/v1alpha1
      kind: BaremetalClusterProviderSpec
      release: {{ mcc_cluster_release }}
      nodeCidr: {{ mcc_node_cidr }}
      dnsNameservers:
{% for dns in dns_servers %}
        - {{ dns }}
{% endfor %}
      dedicatedControlPlane: false
      dedicatedMetallbPools: true
      helmReleases:
        - name: metallb
          values: {}
        - name: stacklight
          values:
            elasticsearch:
              persistentVolumeClaimSize: {{ stacklight_elasticsearch_size }}
            highAvailabilityEnabled: true
            logging:
              enabled: true
            prometheusServer:
              persistentVolumeClaimSize: {{ stacklight_prometheus_size }}
      kaas:
        release: {{ mcc_kaas_release }}
        regional:
        - provider: baremetal
          helmReleases:
          - name: baremetal-operator
            values: {}
          - name: baremetal-provider
            values:
              config:
                customHostnamesEnabled: true
                pauseBeforeDeployment: false
          - name: kaas-ipam
            values: {}
        management:
          enabled: true
